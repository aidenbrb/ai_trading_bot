# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///trading.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot

# ── Alpaca Paper Trading ───────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_PAPER_TRADE=true

# ── Robinhood (stocks, LIVE account - no paper trading exists) ─────────────────
# When ROBINHOOD_ENABLED=true, ALL stock orders route here instead of Alpaca.
# Requires authenticator-app (TOTP) 2FA on the Robinhood account so the bot can
# log in unattended; ROBINHOOD_TOTP_SECRET is the base32 secret shown when you
# set up the authenticator app (not a one-time code).
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOTP_SECRET=
ROBINHOOD_ENABLED=false

# ── Safety flags (do not change until fully validated) ────────────────────────
EXECUTION_ENABLED=false
LIVE_TRADING=false
RISK_REQUIRE_BROKER_CONNECTED=true
AUTO_MARKET_SCHEDULE=true
WEEKEND_CRYPTO_RESEARCH=true

# ── Morning news gate (free RSS/yfinance sources, no API key needed) ───────────
NEWS_GATE_ENABLED=true
NEWS_MAX_AGE_HOURS=18
NEWS_RSS_TIMEOUT_SECONDS=10
NEWS_ITEM_MAX_AGE_HOURS=72
NEWS_VIX_HIGH_THRESHOLD=30
NEWS_VIX_ELEVATED_THRESHOLD=25
# NEWS_DATA_DIR=                 # blank = repo-local data/market_intelligence

# ── Position monitoring ─────────────────────────────────────────────────────────
MONITOR_ATR_TRAIL_MULT=1.5

# Weekend crypto orders use Alpaca paper only.
CRYPTO_EXECUTION_ENABLED=false

# Options research only. This stage never submits an options order.
OPTIONS_RESEARCH_ENABLED=false
OPTIONS_EXECUTION_ENABLED=false
OPTIONS_MIN_DTE=30
OPTIONS_MAX_DTE=60
OPTIONS_EXIT_DTE=7
OPTIONS_MIN_DELTA=0.55
OPTIONS_MAX_DELTA=0.70
OPTIONS_MIN_OPEN_INTEREST=500
OPTIONS_MAX_SPREAD_PCT=0.08
OPTIONS_MAX_RISK_PER_TRADE=0.0025
OPTIONS_MAX_PREMIUM_PCT=0.02
OPTIONS_RESEARCH_EQUITY=100000
